{
  "name": "dsh-aot-runner",
  "version": "1.0.0",
  "private": true,
  "description": "DSH 子进程 runner 的 NativeAOT 实现：把每次调用固定开销从 ~360ms 降到 ~150ms",
  "type": "commonjs",
  "scripts": {
    "build": "dotnet publish -c Release -r win-x64",
    "clean": "rm -rf obj bin",
    "test": "node --test test/ab-verify.js",
    "test:leak": "node --test test/leak-verify.js",
    "test:race": "node --test test/race-verify.js",
    "test:ipc": "node --test test/ipc-verify.js",
    "test:host": "node --test test/host-path-verify.js",
    "test:all": "npm test && npm run test:ipc && npm run test:host && npm run test:leak && npm run test:race",
    "bench": "node bench/d1-ab-bench.js"
  },
  "engines": {
    "node": ">=22"
  }
}
