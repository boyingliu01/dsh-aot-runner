{
  "name": "dsh-aot-runner",
  "version": "0.2.2",
  "private": true,
  "description": "DSH 子进程 runner 的 NativeAOT 实现：消除约 63~67% 的 runner 开销，p99 改善 73~124ms",
  "type": "commonjs",
  "scripts": {
    "build": "dotnet publish -c Release -r win-x64",
    "clean": "rm -rf obj bin",
    "test": "node --test test/ab-verify.js",
    "test:leak": "node --test test/leak-verify.js",
    "test:race": "node --test test/race-verify.js",
    "test:ipc": "node --test test/ipc-verify.js",
    "test:host": "node --test test/host-path-verify.js",
    "test:e2e": "node --test test/e2e-plugin-verify.js",
    "test:plugin": "node --test plugin/test/index.test.js",
    "test:all": "./build.sh --check && npm run lint && npm run test:coverage && npm test && npm run test:ipc && npm run test:host && npm run test:e2e && npm run test:plugin && npm run test:observe && npm run test:hook && npm run test:lint && npm run test:leak && npm run test:race && npm run test:release",
    "bench": "node bench/d1-ab-bench.js",
    "test:coverage": "c8 node --test plugin/test/index.test.js",
    "lint": "npm run lint:syntax && npm run lint:eslint",
    "lint:syntax": "node scripts/check-js-syntax.mjs",
    "lint:eslint": "eslint .",
    "observe": "node bench/aot-observe.js run",
    "observe:report": "node bench/aot-observe.js report",
    "observe:check": "node bench/aot-observe.js check",
    "test:observe": "node --test test/aot-observe-verify.js",
    "probe": "node bench/phase-probe.js",
    "test:hook": "node test/pre-commit-shortcircuit-verify.js",
    "test:lint": "node test/lint-syntax-verify.js",
    "test:release": "node test/check-release-verify.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "c8": "^12.0.0"
  }
}
