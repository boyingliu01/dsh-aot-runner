{
  "name": "dsh-aot-runner",
  "version": "0.2.8",
  "private": true,
  "description": "DSH 子进程 runner 的 NativeAOT 实现：消除约 63~67% 的 runner 开销，p99 改善 73~124ms",
  "type": "commonjs",
  "scripts": {
    "build": "dotnet publish -c Release -r win-x64",
    "clean": "rm -rf obj bin",
    "test": "node --test test/ab-verify.js",
    "test:leak": "node --test test/leak-verify.js",
    "test:race": "node --test test/race-verify.js",
    "test:ipc": "node --test test/ipc-verify.js",
    "test:host": "node --test test/host-path-verify.js",
    "test:e2e": "node --test test/e2e-plugin-verify.js",
    "test:plugin": "node --test plugin/test/*.test.js",
    "test:all": "bash ./build.sh --check && npm run lint && npm run test:eslint-config && npm run test:archlint-whitelist && npm run test:coverage && npm test && npm run test:ipc && npm run test:host && npm run test:e2e && npm run test:plugin && npm run test:observe && npm run test:hook && npm run test:prepush && npm run test:lint && npm run test:leak && npm run test:race && npm run test:release && npm run test:degrade && npm run test:verdict && npm run test:contract && npm run test:contract-coverage && npm run contract:coverage && npm run test:release-slot && npm run test:locate-contract && npm run test:coverage-slot && npm run test:coverage-ratchet && npm run test:patch-shapes && npm run test:vendor-seam",
    "bench": "node bench/d1-ab-bench.js",
    "test:coverage": "c8 --reporter=text --reporter=json-summary node --test plugin/test/index.test.js",
    "lint": "npm run lint:syntax && npm run lint:eslint && npm run test:eslint-config && npm run test:archlint-whitelist && npm run test:version",
    "lint:syntax": "node scripts/check-js-syntax.mjs",
    "lint:eslint": "eslint .",
    "check:version": "node scripts/check-version.mjs",
    "sync:version": "node scripts/sync-version.cjs",
    "test:eslint-config": "node test/eslint-config-coverage-selftest.mjs",
    "test:archlint-whitelist": "node test/archlint-whitelist-selftest.mjs",
    "observe": "node bench/aot-observe.js run",
    "observe:report": "node bench/aot-observe.js report",
    "observe:check": "node bench/aot-observe.js check",
    "test:observe": "node --test test/aot-observe-verify.js",
    "probe": "node bench/phase-probe.js",
    "test:hook": "node test/pre-commit-shortcircuit-verify.js",
    "test:lint": "node test/lint-syntax-verify.js",
    "test:release": "node test/check-release-verify.js",
    "test:release-slot": "node --test test/release-npm-gate-verify.js",
    "test:degrade": "node --test plugin/test/degrade-observability.test.js",
    "test:verdict": "node --test test/bench-verdict-verify.js",
    "isolation": "node bench/isolation-value.js",
    "contract": "node scripts/contract-fingerprint.mjs",
    "contract:update": "node scripts/contract-fingerprint.mjs --update",
    "contract:coverage": "node scripts/contract-coverage-local.mjs",
    "contract:coverage:update": "node scripts/contract-branch-coverage.mjs --update",
    "release:precheck": "node scripts/check-release-slot.mjs",
    "test:contract": "node --test test/contract-fingerprint-verify.js",
    "test:contract-coverage": "node --test test/contract-coverage-check-verify.js",
    "crash:ab": "node bench/coverlet-crash-ab.js",
    "test:prepush": "node --test test/pre-push-shim-verify.js",
    "test:version": "node --test test/check-version-verify.js",
    "test:locate-contract": "node --test test/locate-contract-package.test.mjs",
    "test:coverage-slot": "node --test test/coverage-summary-slot.test.mjs",
    "test:coverage-ratchet": "node --test test/coverage-summary-ratchet.test.mjs",
    "contract:coverage:raw": "node scripts/contract-branch-coverage.mjs --check",
    "test:patch-shapes": "node --test test/patch-shapes-verify.js",
    "test:vendor-seam": "node --test test/vendor-seam-verify.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "c8": "^12.0.0"
  }
}
