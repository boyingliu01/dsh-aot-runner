<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
    <OptimizationPreference>Speed</OptimizationPreference>
    <AssemblyName>dsh-aot-runner</AssemblyName>
    <RootNamespace>DshAotRunner</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- ===== 规避 Low Integrity 陷阱 =====
         若源码树位于被 DSH Windows 沙箱标记为
         "Mandatory Label\Low Mandatory Level" 的目录下（例如曾经的
         workspace-write 会话留下的 ACL 缓存），从该目录启动的 exe 会继承
         Low IL，导致 MSYS/Cygwin 程序（bash/ls/sh）在
         NtCreateDirectoryObject(\BaseNamedObjects\msys-2.0S5-*) 处
         崩溃 0xC0000022，并且无法写 C 盘 TEMP。
         构建产物默认落到 %TEMP% 下即可避开（%TEMP% 通常是 Medium IL）。
         需要自定义时用 -p:RunnerOutDir=... 覆盖。 -->
    <RunnerOutDir Condition="'$(RunnerOutDir)' == ''">$(TEMP)\dsh-aot-runner-dist</RunnerOutDir>

    <!-- ===== NativeAOT 极致优化：减小体积 + 加快启动 =====
         这些开关不改变程序语义。UseSystemResourceKeys 会把框架内部异常消息
         替换为资源 ID，但本 runner 对外暴露的错误对象完全由自己拼装
         （ProtocolJson / EmitProtocolError），不依赖框架异常文本。 -->
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <EventSourceSupport>false</EventSourceSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <StackTraceSupport>false</StackTraceSupport>
    <DebuggerSupport>false</DebuggerSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <NativeDebugSymbols>false</NativeDebugSymbols>
    <AutoreleasePoolSupport>false</AutoreleasePoolSupport>
    <IsTrimmable>true</IsTrimmable>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>

    <!-- 本项目零反射，可安全禁用 -->
    <IlcDisableReflection>true</IlcDisableReflection>
  </PropertyGroup>
</Project>
