<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
    <OptimizationPreference>Speed</OptimizationPreference>
    <AssemblyName>dsh-aot-runner</AssemblyName>
    <RootNamespace>DshAotRunner</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- ===== 产物目录 =====
         正式产物落在仓库内 dist/，可追溯、可进 CI artifact。

         ⚠️ Low Integrity 陷阱（build.sh 会自动自检，见 scripts/check-integrity.sh）：
         若产物目录被标记为 "Mandatory Label\Low Mandatory Level"（例如曾被
         DSH Windows 沙箱以 workspace-write 模式打过标签，且退出时有意保留），
         从该目录启动的 exe 会继承 Low IL，导致：
           - MSYS/Cygwin 程序（bash/ls/sh）崩在
             NtCreateDirectoryObject(\BaseNamedObjects\msys-2.0S5-*)，0xC0000022
           - 无法写 Medium IL 的 %TEMP%（跨完整性级别写入被拒）
         此时用 -p:RunnerOutDir=... 或 build.sh 的 out 参数指向别的 Medium IL 目录。 -->
    <RunnerOutDir Condition="'$(RunnerOutDir)' == ''">$(MSBuildThisFileDirectory)dist</RunnerOutDir>

    <!-- ===== NativeAOT 极致优化：减小体积 + 加快启动 =====
         这些开关不改变程序语义。UseSystemResourceKeys 会把框架内部异常消息
         替换为资源 ID，但本 runner 对外暴露的错误对象完全由自己拼装
         （ProtocolJson / EmitProtocolError），不依赖框架异常文本。 -->
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <EventSourceSupport>false</EventSourceSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <StackTraceSupport>false</StackTraceSupport>
    <DebuggerSupport>false</DebuggerSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <NativeDebugSymbols>false</NativeDebugSymbols>
    <AutoreleasePoolSupport>false</AutoreleasePoolSupport>
    <IsTrimmable>true</IsTrimmable>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>

    <!-- 本项目零反射，可安全禁用 -->
    <IlcDisableReflection>true</IlcDisableReflection>

    <!-- ===== 编译期严格度：不在项目里声明 =====
         值由 XP-Gate Gate 13 适配器统一定义，构建脚本、CI、提交门禁三处都向它索取，
         所以这里、build.sh、workflow 里都不重复写参数（写死就会有两份来源）。

         想调整严格度：改适配器，或设 XP_GATE_COMPILER_STRICTNESS=balanced|strict|warn-only。
         不要在项目文件里加回 TreatWarningsAsErrors 之类的属性。 -->

    <!-- AnalysisLevel 不属于上面那条约束。
         「严格度」tier（balanced/strict）决定的是**要不要把告警升级成错误**，
         由 Gate 13 统一供给；而 AnalysisLevel 决定的是**分析器库里启用哪些规则**，
         是项目自身的性质（这个项目要不要用全部分析器），不是 CI 的严格度档位。

         设成 latest-all 的理由（issue #27）：默认的 latest-recommended 在这个项目上
         **一条告警都没报**（实测），而 latest-all 能报出 30 条生产代码告警。
         「推荐集」对 AOT + P/Invoke 这种项目覆盖不足 —— CA5392（DLL 劫持面）
         就不在推荐集里。豁免项在 .editorconfig 里逐条写明理由。 -->
    <AnalysisLevel>latest-all</AnalysisLevel>

    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- tests/ 是独立的测试项目（有自己的 csproj 与 xunit 依赖）。
         SDK 默认的 **/*.cs 通配会把 tests/ 下的 .cs 一起编进主项目，
         结果是主项目编译时找不到 xunit 类型（CS0246），
         而且测试代码会被打进 AOT 产物。这里显式排除。 -->
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />

    <!-- tools/ 下是独立的开发期工具（各自带 csproj），不参与 runner 的 AOT 构建。
         不排除的话，SDK 的 **/*.cs 通配会把 tools/cast-audit 的源码编进主项目，
         实际症状是 obj/ 下的程序集属性重复（CS0579），
         而且 Roslyn 依赖会被拖进 AOT 的引用图里。 -->
    <Compile Remove="tools/**" />
    <None Remove="tools/**" />
  </ItemGroup>
</Project>
