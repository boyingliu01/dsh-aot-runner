.vs/
.vscode/
.idea/
*.swp
.DS_Store

# 临时
tmp/
tmp-test/
*.bak
*.bak-*

# AOT 长期观测的落盘数据（本地基准结果，不进版本库）
.aot-observation/

# xp-gate 工具产物（xp-gate init 的本机安装副本）
#
# 这些是 xp-gate 自己的代码，不是本项目的代码：
#   .xp-gate/modules/    principles/mutation/mock-policy/build-integrity（约 11M）
#   githooks/            adapter-*.sh + adapters/（约 580K）
#   .qoder/ opencode.json  其它 AI 工具的本机配置
#
# 不忽略的后果（实测）：principles 的 Gate 6 用 archlint 零容忍模式扫全目录，
# 会把 githooks/ 与 .git/hooks/ 里的同一份 adapter 判为 CodeClone[High]，
# 提交被永久 BLOCK —— 报的是工具自己的重复，不是本项目的债。
#
# 保留它们在磁盘上供 hook 使用即可；hook 找不到项目内副本时会回落到
# ~/.config/xp-gate/ 的全局安装，两条路都验证过。
.xp-gate/modules/
.xp-gate/node_modules/
.xp-gate/package.json
.xp-gate/package-lock.json
.xp-gate/lint-baseline.json
githooks/
.qoder/
opencode.json

# xp-gate 本机探测到的语言/工具清单（由 detect-languages 生成，随机器变化）
.xp-gate-config.json

# xp-gate 每次跑门禁生成的报告与历史（随机器/时间变化，不是项目状态）
.xp-gate/reports/
.xp-gate/quality-status/
.quality-history.jsonl

# dotnet test 覆盖率产物（每次跑都会生成新的 GUID 子目录）
tests/**/TestResults/

# 基准测试生成的数据（用 bench/node-tuning/README.md 里的命令重建）
bench/node-tuning/files/
bench/node-tuning/files2/
bench/node-tuning/tiny/
bench/node-tuning/results/*.txt
bench/node-tuning/big/
bench/node-tuning/sz-*/
bench/node-tuning/sz2-*/

# 临时草稿（issue 正文、探针脚本等）。这类文件曾被误 add 进提交 ——
# 它们不是产物，也不该出现在版本库里，但名字太随意容易被 `git add -A` 带走。
.tmp-*

# c8 / vitest 在测量期间产生的原始片段（每次运行都会生成，不是源码）。
#
# 注意**不能**整目录忽略 coverage/：coverage/coverage-summary.json 是
# xp-gate Gate 5 判定 80% 覆盖率地板时**唯一**会去读的路径
# （见 xp-gate/hooks/gate-entries/gate-5-entry.sh 的 _gate5_coverage_usable）。
# Gate 5 的测试命令是 `node --test test/ab-verify.js`，不产覆盖率报告，
# 所以它也无法在门禁期间现生成 —— 这份文件必须**事先就在版本库里**，
# 否则 Gate 5 直接 `BLOCKED - coverage/coverage-summary.json not found`，提交被拦死（实测）。
#
# 代价与对策：它是生成物，内容里存的是生成那台机器的绝对路径
# （实测 D:\projects\dsh-aot-runner\plugin\lib\...）。因此：
#   · CI 的「检查是否误提交构建产物」已把它单独列为允许项
#     （见 .github/workflows/ci.yml，其余 coverage/ 文件仍然拦）
#   · 改动 plugin/ 代码后要重跑 `npm run test:coverage` 更新它，
#     并用 `git update-index --assume-unchanged` 之外的正常方式提交差异 ——
#     路径差异本身就是「这份摘要来自哪台机器」的证据
# 所以这里只忽略中间产物 coverage/tmp/，把摘要文件留出来。
coverage/tmp/

# sprint-flow 的隔离工作区（Phase 1 PREP 创建，完成任务后由 Phase 6 CLOSE 删除）。
# 不忽略的话 `git status` 会把每个 worktree 的整棵树当成未跟踪文件列出来。
.worktrees/
