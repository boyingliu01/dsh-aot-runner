#!/bin/sh
# 本仓库的 pre-commit 分两段，缺一不可：
#
#   第 1 段（本项目自有快检）
#     - JS 语法检查（扫描口径与 package.json 的 files 一致）
#     - C# 格式检查（dotnet format --verify-no-changes）
#     理由：这两项是「快、不必构建」的阻断式检查，xp-gate 的 Gate 1 对
#     C# 是 fail-open（适配器返回 1 只打印 "may be non-blocking" 然后 SKIP），
#     所以 C# 格式必须在本地这一段守住，交给全局 hook 会漏。
#
#   第 2 段（xp-gate 全局门禁）
#     直接 exec 全局安装的 xp-gate pre-commit，跑 Gate 0-13。
#     xp-gate init 只把 hook 装到 .git/hooks/，而本仓库 core.hooksPath=.githooks
#     会盖掉它 —— 不显式转发的话，xp-gate 在本项目等于完全没生效。
#
# 两段是有意组合而非替代：本段在 C# 编译期质量上比全局更严（阻断 vs fail-open），
# 全局在复杂度/重复/架构/密钥/SAST/文件卫生等维度覆盖面更广。详见
# docs/QUALITY-GATES.md。
set -e

PROJECT_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$PROJECT_ROOT"

echo "[pre-commit] JS 语法检查"
JS_FAIL=0
JS_COUNT=0
for f in $(find test bench plugin -name '*.js' -not -path '*/node_modules/*' | sort); do
  JS_COUNT=$((JS_COUNT + 1))
  if ! node --check "$f"; then
    echo "  语法错误: $f" >&2
    JS_FAIL=1
  fi
done
if [ "$JS_FAIL" -ne 0 ]; then
  echo "[pre-commit] JS 语法检查未通过" >&2
  exit 1
fi
# 扫描到 0 个文件说明启动路径出了问题（例如在错误目录执行），
# 这时报 OK 等于假装检查过了。
if [ "$JS_COUNT" -eq 0 ]; then
  echo "[pre-commit] 没找到任何 JS 文件 —— 检查路径可能不对" >&2
  exit 1
fi
echo "[pre-commit]   $JS_COUNT 个文件通过"

if command -v dotnet >/dev/null 2>&1; then
  echo "[pre-commit] C# 格式检查"
  # 仓库里同时存在 .sln 和 .csproj 时，`dotnet format` 无法自行选择 workspace，
  # 会抛 FileNotFoundException 直接崩掉。此前只有 .csproj，所以没暴露；加入 .sln 后
  # 这道检查从「检查格式」变成了「一律失败」，与代码是否合规无关。这里显式指定 .sln。
  FORMAT_TARGET=""
  for sln in ./*.sln; do
    [ -f "$sln" ] && FORMAT_TARGET="$sln" && break
  done
  if ! dotnet format ${FORMAT_TARGET:+"$FORMAT_TARGET"} --verify-no-changes --verbosity quiet >/dev/null 2>&1; then
    echo "[pre-commit] 格式不合规，运行 'dotnet format' 修复后重新提交" >&2
    exit 1
  fi
else
  echo "[pre-commit] 跳过 C# 检查（未找到 dotnet）"
fi

# ---- 第 2 段：转交 xp-gate 全局门禁 ----
# 候选顺序：全局 config 下的 hooks → .git/hooks（xp-gate init 的安装位置）。
# 都找不到就明确告警而非静默放行 —— 「没跑」不能看起来像「通过」。
XP_GATE_HOOK=""
for candidate in \
  "$HOME/.config/xp-gate/hooks/pre-commit" \
  "$PROJECT_ROOT/.git/hooks/pre-commit"; do
  if [ -f "$candidate" ] && [ "$candidate" != "$PROJECT_ROOT/.githooks/pre-commit" ]; then
    XP_GATE_HOOK="$candidate"
    break
  fi
done

if [ -z "$XP_GATE_HOOK" ]; then
  echo "[pre-commit] ⚠️  未找到 xp-gate pre-commit，全局质量门禁本次未执行" >&2
  echo "[pre-commit]    修复: xp-gate init --full  或  xp-gate setup-global" >&2
else
  echo "[pre-commit] 转交 xp-gate 全局门禁: $XP_GATE_HOOK"
  exec sh "$XP_GATE_HOOK" "$@"
fi
